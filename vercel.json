{
    "version": 2,
    "builds": [
      {
        "src": "AI_Backend/Agent_API.py",
        "use": "@vercel/python"
      },
      {
        "src": "AI_Frontend/package.json",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "AI_Backend/Agent_API.py"
      },
      {
        "src": "/(.*)",
        "dest": "AI_Frontend/$1"
      }
    ]
  }
  